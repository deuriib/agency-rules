{
  "version": 2,
  "harnesses": {
    "antigravity": {
      "id": "antigravity",
      "label": "Google Antigravity",
      "format": "md-yaml-trigger",
      "installKind": "per-rule",
      "integrationPath": "{slug}.md",
      "detect": {
        "dirs": [
          ".agents",
          "~/.gemini"
        ],
        "files": [
          "GEMINI.md",
          "AGENTS.md"
        ]
      },
      "dest": {
        "project": ".agents/rules/{slug}.md",
        "user": "~/.gemini/config/rules/{slug}.md"
      },
      "frontmatter": {
        "required": [
          "trigger"
        ],
        "map": {
          "trigger": "always_on|glob|model_decision|manual",
          "globs": "string",
          "description": "string"
        }
      }
    },
    "piAgent": {
      "id": "piAgent",
      "label": "Pi Coding Agent",
      "format": "md-rules-dir",
      "installKind": "per-rule",
      "integrationPath": "{slug}/RULES.md",
      "detect": {
        "dirs": [
          ".pi",
          "~/.pi"
        ]
      },
      "dest": {
        "project": ".pi/rules/{slug}/RULES.md",
        "user": "~/.pi/agent/rules/{slug}/RULES.md"
      },
      "frontmatter": {
        "required": [
          "name",
          "description"
        ],
        "map": {
          "name": "string",
          "description": "string",
          "tools": "array<string>"
        }
      }
    },
    "ohMyPi": {
      "id": "ohMyPi",
      "label": "oh-my-pi (omp)",
      "format": "md-or-mdc",
      "installKind": "per-rule",
      "integrationPath": "{slug}.md",
      "detect": {
        "dirs": [
          ".omp",
          "~/.omp"
        ]
      },
      "dest": {
        "project": ".omp/rules/{slug}.md",
        "user": "~/.omp/agent/rules/{slug}.md"
      },
      "frontmatter": {
        "required": [
          "name",
          "description"
        ],
        "map": {
          "name": "string",
          "description": "string",
          "globs": "array<string>|string",
          "alwaysApply": "boolean"
        }
      },
      "extensions": [
        ".md",
        ".mdc"
      ]
    },
    "opencode": {
      "id": "opencode",
      "label": "OpenCode (via opencode-rules)",
      "format": "md-plugin",
      "installKind": "per-rule",
      "integrationPath": "{slug}.md",
      "detect": {
        "dirs": [
          ".opencode",
          "~/.config/opencode"
        ]
      },
      "dest": {
        "project": ".opencode/rules/{slug}.md",
        "user": "~/.config/opencode/rules/{slug}.md"
      },
      "frontmatter": {
        "required": [
          "description"
        ],
        "map": {
          "description": "string",
          "globs": "array<string>|string",
          "match": "\"any\"|\"all\""
        }
      },
      "plugin": {
        "package": "opencode-rules",
        "entry": "opencode-rules@latest"
      }
    },
    "cursor": {
      "id": "cursor",
      "label": "Cursor",
      "format": "md-cursor-mdc",
      "installKind": "per-rule",
      "integrationPath": "{slug}.mdc",
      "detect": {
        "dirs": [
          ".cursor",
          "~/.cursor"
        ]
      },
      "dest": {
        "project": ".cursor/rules/{slug}.mdc",
        "user": "~/.cursor/rules/{slug}.mdc"
      },
      "frontmatter": {
        "required": [
          "description"
        ],
        "map": {
          "description": "string",
          "globs": "string",
          "alwaysApply": "boolean"
        }
      },
      "extensions": [
        ".mdc"
      ]
    },
    "claudeCode": {
      "id": "claudeCode",
      "label": "Claude Code",
      "format": "md-claude-rules",
      "installKind": "per-rule",
      "integrationPath": "{slug}.md",
      "detect": {
        "dirs": [
          ".claude",
          "~/.claude"
        ],
        "files": [
          "CLAUDE.md"
        ]
      },
      "dest": {
        "project": ".claude/rules/{slug}.md",
        "user": "~/.claude/rules/{slug}.md"
      },
      "frontmatter": {
        "required": [],
        "map": {
          "paths": "array<string>"
        }
      }
    }
  }
}
